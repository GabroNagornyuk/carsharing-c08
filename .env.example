# cp .env.example .env – необов'язково: ті самі значення є типовими в compose.yaml.

# Порти на хості
NGINX_PORT=8080
APP_A_PORT=8001
APP_B_PORT=8002
API_PORT=8000
POSTGRES_PORT=5432

# Клієнти працюють поза Compose (CORS)
WEB_CLIENT_ORIGIN=http://localhost:8081,http://127.0.0.1:8081
DPC_CLIENT_ORIGIN=http://localhost:8083,http://127.0.0.1:8083

# Web
HOLD_MINUTES=15
# Web ЛР3: строк сесії, обмеження спроб входу (Д3.3)
SESSION_TTL_MIN=60
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MIN=15
IDEMPOTENCY_TTL_H=24
IDEMPOTENCY_CLEANUP_S=60
POOL_SIZE=10
PG_MAX_CONNECTIONS=100

# DPC: RESOURCE_MODE=unprotected лише для досліду О1.4 на зоні test-unprotected
API_TOKEN=dev-token
QUEUE_CAPACITY=50
WORKERS=4
RESOURCE_MODE=locked
LICENSE_CHECK_MS=300-900

# DPC ЛР2: пул процесів розрахунку – fresh (на кожен запит) | warm (один на весь час роботи)
COMPUTE_POOL=fresh
COMPUTE_TOLERANCE=1e-6

# DPC ЛР3: ray – команди старту виконують задачі Ray | local – пул обробників ЛР1 (потрібен для RESOURCE_MODE=unprotected)
EXECUTION=ray
IN_FLIGHT_LIMIT=8
RAY_MAX_RETRIES=3
RAY_DASHBOARD_PORT=8265
